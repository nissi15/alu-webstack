#!/usr/bin/env bash
# Displays the DNS record type and destination of the subdomains of a domain

show_subdomain () {
    domain=$1
    subdomain=$2
    answer=$(dig "$subdomain.$domain" | grep -A1 "ANSWER SECTION:" | tail -1)
    echo "$answer" | awk -v name="$subdomain" '{ print "The subdomain " name " is a " $4 " record and points to " $5 }'
}

if [ "$#" -eq 1 ]; then
    for subdomain in www lb-01 web-01 web-02; do
        show_subdomain "$1" "$subdomain"
    done
else
    show_subdomain "$1" "$2"
fi
